"use client";
import { useEffect, useState, useCallback } from "react";
import { useParams, useRouter } from "next/navigation";
import Image from "next/image";
import Link from "next/link";
import Header from "@/components/Header";
import { COLORS, STYLES } from "@/constants/theme";

interface Product {
  _id: string;
  name: string;
  price: number;
  description: string;
  category: string;
  stock: number;
  sizes?: string[];
  colors?: string[];
  images: string[];
  rating?: number;
  reviews?: number;
  sku?: string;
}

interface CartItem extends Product {
  cartId: string;
  size: string;
  color: string;
  qty: number;
}

interface ApiResponse {
  product?: Product;
  error?: string;
  success?: boolean;
}

export default function ProductDetail() {
  const params = useParams();
  const router = useRouter();
  const productId = params.id as string;

  // State Management
  const [product, setProduct] = useState<Product | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [selectedSize, setSelectedSize] = useState("");
  const [selectedColor, setSelectedColor] = useState("");
  const [activeImage, setActiveImage] = useState(0);
  const [quantity, setQuantity] = useState(1);
  const [isAddingToCart, setIsAddingToCart] = useState(false);
  const [cartNotification, setCartNotification] = useState<string | null>(null);
  const [imageErrors, setImageErrors] = useState<Set<number>>(new Set());

  // Fetch Product Details
  useEffect(() => {
    const fetchProduct = async () => {
      try {
        setLoading(true);
        setError(null);

        const response = await fetch(`/api/products/${productId}`, {
          method: "GET",
          headers: { "Content-Type": "application/json" },
        });

        if (!response.ok) {
          throw new Error(`Product not found (${response.status})`);
        }

        const data: ApiResponse = await response.json();

        if (!data.success || !data.product) {
          throw new Error(data.error || "Failed to load product");
        }

        setProduct(data.product);

        // Set default selections
        if (data.product.sizes?.length) {
          setSelectedSize(data.product.sizes[0]);
        }
        if (data.product.colors?.length) {
          setSelectedColor(data.product.colors[0]);
        }
      } catch (err) {
        const errorMessage = err instanceof Error ? err.message : "Unknown error occurred";
        setError(errorMessage);
        console.error("Product fetch error:", err);
      } finally {
        setLoading(false);
      }
    };

    if (productId) {
      fetchProduct();
    }
  }, [productId]);

  // Add to Cart Handler
  const addToCart = useCallback(async () => {
    if (!product) return;

    // Validation
    if (!selectedSize && product.sizes?.length) {
      setError("Please select a size");
      return;
    }
    if (!selectedColor && product.colors?.length) {
      setError("Please select a color");
      return;
    }
    if (quantity < 1) {
      setError("Quantity must be at least 1");
      return;
    }

    try {
      setIsAddingToCart(true);
      setError(null);

      // Get existing cart
      const cartData = localStorage.getItem("cart");
      const cart: CartItem[] = cartData ? JSON.parse(cartData) : [];

      // Generate unique cart ID
      const cartId = `${product._id}-${selectedSize}-${selectedColor}`;

      // Check if item already exists
      const existingIndex = cart.findIndex((item) => item.cartId === cartId);

      if (existingIndex > -1) {
        // Update quantity
        cart[existingIndex].qty += quantity;
      } else {
        // Add new item
        const newItem: CartItem = {
          ...product,
          cartId,
          size: selectedSize,
          color: selectedColor,
          qty: quantity,
        };
        cart.push(newItem);
      }

      // Save to localStorage
      localStorage.setItem("cart", JSON.stringify(cart));

      // Show success notification
      setCartNotification(`✓ ${product.name} cart mein add ho gaya!`);

      // Auto-dismiss notification
      setTimeout(() => setCartNotification(null), 3000);

      // Reset quantity
      setQuantity(1);
    } catch (err) {
      const errorMessage = err instanceof Error ? err.message : "Failed to add to cart";
      setError(errorMessage);
      console.error("Add to cart error:", err);
    } finally {
      setIsAddingToCart(false);
    }
  }, [product, selectedSize, selectedColor, quantity]);

  // Handle Image Load Error
  const handleImageError = (index: number) => {
    setImageErrors((prev) => new Set(prev).add(index));
  };

  // Quantity Handlers
  const incrementQuantity = () => setQuantity((q) => q + 1);
  const decrementQuantity = () => setQuantity((q) => (q > 1 ? q - 1 : 1));

  // Loading State
  if (loading) {
    return (
      <div style={{ minHeight: "100vh", background: COLORS.background, fontFamily: STYLES.fontFamily }}>
        <Header />
        <div style={{ padding: "40px 24px", textAlign: "center" }}>
          <div style={STYLES.loadingSpinner} />
          <p style={{ color: COLORS.textMuted, marginTop: "16px" }}>
            Loading product details...
          </p>
        </div>
      </div>
    );
  }

  // Error State
  if (error && !product) {
    return (
      <div style={{ minHeight: "100vh", background: COLORS.background, fontFamily: STYLES.fontFamily }}>
        <Header />
        <div style={{ padding: "40px 24px", maxWidth: "600px", margin: "0 auto" }}>
          <div style={STYLES.errorContainer}>
            <h3 style={{ margin: "0 0 8px 0", color: COLORS.error }}>Product Not Found</h3>
            <p style={{ margin: "0 0 16px 0", color: COLORS.textSecondary, fontSize: "14px" }}>
              {error}
            </p>
            <Link href="/" style={{ textDecoration: "none" }}>
              <button style={{ ...STYLES.primaryButton, fontSize: "13px", padding: "8px 16px" }}>
                Back to Products
              </button>
            </Link>
          </div>
        </div>
      </div>
    );
  }

  if (!product) {
    return (
      <div style={{ minHeight: "100vh", background: COLORS.background, fontFamily: STYLES.fontFamily }}>
        <Header />
        <div style={{ padding: "40px 24px", textAlign: "center" }}>
          <p style={{ color: COLORS.textMuted }}>Product not found.</p>
          <Link href="/" style={{ textDecoration: "none" }}>
            <button style={{ ...STYLES.primaryButton, marginTop: "16px" }}>
              Go Back
            </button>
          </Link>
        </div>
      </div>
    );
  }

  const images = product.images && product.images.length > 0 ? product.images : [];
  const hasVariants = (product.sizes?.length || 0) > 0 || (product.colors?.length || 0) > 0;

  return (
    <div style={{ minHeight: "100vh", background: COLORS.background, fontFamily: STYLES.fontFamily }}>
      <Header />

      {/* Breadcrumb */}
      <nav style={{ padding: "12px 24px", fontSize: "12px" }} aria-label="Breadcrumb">
        <Link href="/" style={{ color: COLORS.primary, textDecoration: "none" }}>
          Home
        </Link>
        <span style={{ color: COLORS.textMuted, margin: "0 8px" }}>/</span>
        <Link
          href={`/?category=${product.category}`}
          style={{ color: COLORS.primary, textDecoration: "none" }}
        >
          {product.category}
        </Link>
        <span style={{ color: COLORS.textMuted, margin: "0 8px" }}>/</span>
        <span style={{ color: COLORS.textMuted }}>{product.name}</span>
      </nav>

      {/* Notification */}
      {cartNotification && (
        <div
          style={{
            position: "fixed",
            top: "20px",
            right: "20px",
            background: COLORS.success,
            color: COLORS.white,
            padding: "12px 20px",
            borderRadius: "8px",
            fontSize: "14px",
            fontWeight: "600",
            zIndex: 1000,
            animation: "slideUp 0.3s ease",
          }}
          role="status"
          aria-live="polite"
        >
          {cartNotification}
        </div>
      )}

      {/* Error Notification */}
      {error && (
        <div
          style={{
            position: "fixed",
            top: "20px",
            right: "20px",
            background: COLORS.error,
            color: COLORS.white,
            padding: "12px 20px",
            borderRadius: "8px",
            fontSize: "14px",
            fontWeight: "600",
            zIndex: 1000,
          }}
          role="alert"
          aria-live="assertive"
        >
          {error}
        </div>
      )}

      {/* Main Content */}
      <main
        style={{
          padding: "24px",
          maxWidth: "1000px",
          margin: "0 auto",
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(350px, 1fr))",
          gap: "40px",
        }}
        role="main"
      >
        {/* Image Gallery */}
        <div>
          {/* Main Image */}
          <div
            style={{
              width: "100%",
              height: "400px",
              background: COLORS.imageBg,
              borderRadius: "12px",
              overflow: "hidden",
              marginBottom: "12px",
              position: "relative",
            }}
          >
            {images.length > 0 && !imageErrors.has(activeImage) ? (
              <Image
                src={images[activeImage]}
                alt={`${product.name} - Product image ${activeImage + 1}`}
                width={400}
                height={400}
                priority={activeImage === 0}
                quality={85}
                style={{
                  width: "100%",
                  height: "100%",
                  objectFit: "cover",
                }}
                onError={() => handleImageError(activeImage)}
              />
            ) : (
              <div
                style={{
                  width: "100%",
                  height: "100%",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  color: COLORS.textSecondary,
                }}
              >
                <span>Image not available</span>
              </div>
            )}
          </div>

          {/* Thumbnail Gallery */}
          {images.length > 1 && (
            <div style={{ display: "flex", gap: "8px", flexWrap: "wrap" }}>
              {images.map((img, i) => (
                <button
                  key={i}
                  onClick={() => setActiveImage(i)}
                  style={{
                    width: "70px",
                    height: "70px",
                    padding: 0,
                    borderRadius: "6px",
                    border: activeImage === i ? `2px solid ${COLORS.primary}` : `1px solid ${COLORS.border}`,
                    cursor: "pointer",
                    overflow: "hidden",
                    transition: "all 0.2s ease",
                    background: COLORS.imageBg,
                  }}
                  aria-pressed={activeImage === i}
                  aria-label={`View image ${i + 1}`}
                >
                  <Image
                    src={img}
                    alt={`Thumbnail ${i + 1}`}
                    width={70}
                    height={70}
                    style={{
                      width: "100%",
                      height: "100%",
                      objectFit: "cover",
                    }}
                    onError={() => handleImageError(i)}
                  />
                </button>
              ))}
            </div>
          )}
        </div>

        {/* Product Details */}
        <div>
          {/* Header */}
          <div style={{ marginBottom: "16px" }}>
            <span
              style={{
                display: "inline-block",
                background: COLORS.primary,
                color: COLORS.white,
                padding: "4px 12px",
                borderRadius: "20px",
                fontSize: "11px",
                fontWeight: "600",
                marginBottom: "8px",
              }}
            >
              {product.category}
            </span>
            <h1
              style={{
                fontSize: "28px",
                fontWeight: "700",
                color: COLORS.textPrimary,
                margin: "0 0 8px 0",
              }}
            >
              {product.name}
            </h1>

            {/* Rating */}
            {product.rating && (
              <div style={{ marginBottom: "12px" }}>
                <span style={{ fontSize: "14px", color: COLORS.textSecondary }}>
                  ⭐ {product.rating.toFixed(1)} ({product.reviews || 0} reviews)
                </span>
              </div>
            )}
          </div>

          {/* Price Section */}
          <div style={{ marginBottom: "20px", paddingBottom: "20px", borderBottom: `1px solid ${COLORS.border}` }}>
            <p
              style={{
                fontSize: "32px",
                fontWeight: "800",
                color: COLORS.primary,
                margin: 0,
              }}
            >
              ₹{typeof product.price === "number" ? product.price.toLocaleString("en-IN") : product.price}
            </p>
            <p
              style={{
                fontSize: "12px",
                color: COLORS.textMuted,
                margin: "8px 0 0 0",
              }}
            >
              {product.stock > 0 ? `✓ In Stock (${product.stock} available)` : "Out of Stock"}
            </p>
            {product.sku && (
              <p style={{ fontSize: "12px", color: COLORS.textMuted, margin: "4px 0 0 0" }}>
                SKU: {product.sku}
              </p>
            )}
          </div>

          {/* Description */}
          <p
            style={{
              fontSize: "14px",
              color: COLORS.textSecondary,
              lineHeight: "1.8",
              margin: "0 0 20px 0",
            }}
          >
            {product.description}
          </p>

          {/* Size Selection */}
          {product.sizes && product.sizes.length > 0 && (
            <div style={{ marginBottom: "16px" }}>
              <label
                style={{
                  display: "block",
                  fontSize: "13px",
                  fontWeight: "600",
                  color: COLORS.textPrimary,
                  marginBottom: "8px",
                }}
              >
                Size: <span style={{ fontWeight: "700" }}>{selectedSize}</span>
              </label>
              <div style={{ display: "flex", gap: "8px", flexWrap: "wrap" }}>
                {product.sizes.map((size) => (
                  <button
                    key={size}
                    onClick={() => setSelectedSize(size)}
                    style={{
                      padding: "10px 18px",
                      borderRadius: "6px",
                      border:
                        selectedSize === size
                          ? `2px solid ${COLORS.primary}`
                          : `1px solid ${COLORS.border}`,
                      background: selectedSize === size ? COLORS.primary : COLORS.white,
                      color: selectedSize === size ? COLORS.white : COLORS.textPrimary,
                      fontSize: "13px",
                      fontWeight: "600",
                      cursor: "pointer",
                      transition: "all 0.2s ease",
                    }}
                    aria-pressed={selectedSize === size}
                    aria-label={`Select size ${size}`}
                  >
                    {size}
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* Color Selection */}
          {product.colors && product.colors.length > 0 && (
            <div style={{ marginBottom: "20px" }}>
              <label
                style={{
                  display: "block",
                  fontSize: "13px",
                  fontWeight: "600",
                  color: COLORS.textPrimary,
                  marginBottom: "8px",
                }}
              >
                Color: <span style={{ fontWeight: "700" }}>{selectedColor}</span>
              </label>
              <div style={{ display: "flex", gap: "8px", flexWrap: "wrap" }}>
                {product.colors.map((color) => (
                  <button
                    key={color}
                    onClick={() => setSelectedColor(color)}
                    style={{
                      padding: "10px 18px",
                      borderRadius: "6px",
                      border:
                        selectedColor === color
                          ? `2px solid ${COLORS.primary}`
                          : `1px solid ${COLORS.border}`,
                      background: selectedColor === color ? COLORS.primary : COLORS.white,
                      color: selectedColor === color ? COLORS.white : COLORS.textPrimary,
                      fontSize: "13px",
                      fontWeight: "600",
                      cursor: "pointer",
                      transition: "all 0.2s ease",
                    }}
                    aria-pressed={selectedColor === color}
                    aria-label={`Select color ${color}`}
                  >
                    {color}
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* Quantity Selector */}
          <div style={{ marginBottom: "20px" }}>
            <label
              htmlFor="quantity"
              style={{
                display: "block",
                fontSize: "13px",
                fontWeight: "600",
                color: COLORS.textPrimary,
                marginBottom: "8px",
              }}
            >
              Quantity
            </label>
            <div style={{ display: "flex", alignItems: "center", gap: "8px" }}>
              <button
                onClick={decrementQuantity}
                style={{
                  width: "40px",
                  height: "40px",
                  borderRadius: "6px",
                  border: `1px solid ${COLORS.border}`,
                  background: COLORS.white,
                  cursor: "pointer",
                  fontSize: "18px",
                  fontWeight: "600",
                  transition: "all 0.2s ease",
                }}
                aria-label="Decrease quantity"
              >
                −
              </button>
              <input
                id="quantity"
                type="number"
                min="1"
                value={quantity}
                onChange={(e) => setQuantity(Math.max(1, parseInt(e.target.value) || 1))}
                style={{
                  width: "60px",
                  padding: "8px",
                  borderRadius: "6px",
                  border: `1px solid ${COLORS.border}`,
                  textAlign: "center",
                  fontSize: "14px",
                  fontWeight: "600",
                }}
                aria-label="Product quantity"
              />
              <button
                onClick={incrementQuantity}
                style={{
                  width: "40px",
                  height: "40px",
                  borderRadius: "6px",
                  border: `1px solid ${COLORS.border}`,
                  background: COLORS.white,
                  cursor: "pointer",
                  fontSize: "18px",
                  fontWeight: "600",
                  transition: "all 0.2s ease",
                }}
                aria-label="Increase quantity"
              >
                +
              </button>
            </div>
          </div>

          {/* Action Buttons */}
          <div style=
